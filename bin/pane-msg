#!/usr/bin/env bash
# pane-msg — file-based inter-pane messaging for the claude-multipane setup.
#
# Instead of pasting a whole task into another pane's input prompt (which gets
# stuck as "[Pasted text #N]" and leaves no trail), the payload is appended to
# the recipient's inbox file and only a tiny "read-inbox" nudge is sent to its
# prompt (Nudge-Hybrid). Each pane drains its own inbox with `pane-msg read`.
#
# Usage:
#   pane-msg send <target> [--type T] [--ref R] [--from F] [--silent] <body...>
#   pane-msg read  [<self-target>]     # print+consume unread (auto-detects self)
#   pane-msg peek  [<self-target>]     # print unread WITHOUT consuming
#   pane-msg status                    # unread counts across all mailboxes
#   pane-msg whoami                    # this pane's tmux target
#
#   <target> / <self-target>: a tmux target like "4later:1.2".
#   --type:  task | question | answer | status | note   (default: note)
#   --ref:   free-form reference, e.g. an issue number
#   By default a GUARDED nudge is sent: if the target is idle with an EMPTY input
#   line, a tiny read-inbox nudge wakes it so it reads immediately; if it's busy
#   or the user is typing there, no nudge is sent and the recipient's Stop-hook
#   delivers the message on its next turn. Either way the prompt is never clobbered.
#   --silent:      never nudge — append only; Stop-hook delivers on next turn.
#   --nudge:       explicit default (guarded wake); kept for clarity.
#   --force-nudge: nudge even if the input has text (legacy; CAN clobber input).
set -euo pipefail

MB="${PANE_MSG_HOME:-$HOME/.claude/tmux-state/mailbox}"
mkdir -p "$MB"

# tmux target ("4later:1.2") -> mailbox key ("4later_1_2")
key_of() { printf '%s' "$1" | tr ':.' '__'; }

self_target() {
  local t
  # $TMUX_PANE is the unique id of the pane THIS process runs in — reliable even
  # when the attached client is looking at a different pane. Prefer it over a
  # target-less display-message (which resolves to the client's *active* pane).
  if [ -n "${TMUX_PANE:-}" ]; then
    t="$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}:#{window_index}.#{pane_index}' 2>/dev/null)" \
      && [ -n "$t" ] && { printf '%s' "$t"; return; }
  fi
  t="$(tmux display-message -p '#{session_name}:#{window_index}.#{pane_index}' 2>/dev/null)" \
    && [ -n "$t" ] && { printf '%s' "$t"; return; }
  echo "pane-msg: not inside tmux — pass an explicit target" >&2; exit 1
}

# Return 0 only if it is SAFE to type into the target's prompt: Claude not busy
# AND the input line carries no REAL user keystrokes.
input_is_clear() {
  local target="$1" cap line rest esc
  esc=$'\e'
  # Read WITH escape sequences (-e). Crucial: Claude Code pre-fills an idle
  # prompt with a dimmed next-step SUGGESTION (ghost text, rendered faint via
  # SGR 2 = ESC[2m…). That is NOT the user typing. Reading the plain text can't
  # tell them apart, so the guard mistook the ever-present suggestion for input
  # and never woke a pane (field find 2026-07-28, the real cause of sleepers).
  cap="$(tmux capture-pane -t "$target" -p -e 2>/dev/null)" || return 1
  # Busy? Claude shows "esc to interrupt" while working — never touch it then.
  printf '%s\n' "$cap" | grep -q 'esc to interrupt' && return 1
  # The live input line is the last one carrying the prompt marker "❯".
  # (An EMPTY prompt renders as bare "❯" — capture trims the trailing space —
  # so match the marker without a following space.)
  line="$(printf '%s\n' "$cap" | grep '❯' | tail -1)"
  [ -n "$line" ] || return 1        # no prompt visible → don't risk it
  # Strip the dimmed suggestion span (ESC[2m + its faint text, up to the next
  # escape), then all remaining SGR escapes. What's left after the marker is
  # only REAL user input, if any.
  line="$(printf '%s' "$line" | sed -E "s/${esc}\[2m[^${esc}]*//g; s/${esc}\[[0-9;]*m//g")"
  rest="${line#*❯}"
  rest="$(printf '%s' "$rest" | tr -d '[:space:]')"
  [ -z "$rest" ]                    # nothing real after the marker → safe to nudge
}

nudge() {
  local target="$1"
  # Minimal wake trigger — payload stays in the inbox file. Only ever sent when
  # input_is_clear() confirmed the line is empty. Two Enters per send-to-pane.
  tmux send-keys -t "$target" -l '📨 pane-msg: run `pane-msg read` and handle the queued message(s)'
  tmux send-keys -t "$target" Enter
  tmux send-keys -t "$target" Enter
}

cmd="${1:-}"; shift || true

case "$cmd" in
  send)
    # nudge modes: auto (DEFAULT — guarded wake: nudge only if the target's input
    # line is empty & it isn't busy, so it can't clobber typing; otherwise falls
    # back to Stop-hook delivery), never (pure Stop-hook, never touches the
    # prompt), force (nudge regardless — can clobber).
    nudge_mode="auto"; type="note"; ref=""; from=""
    target="${1:-}"; shift || { echo "pane-msg send: missing <target>" >&2; exit 1; }
    # parse flags interleaved with body
    body_parts=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --nudge)       nudge_mode="auto";  shift;;   # opt-in: wake an idle pane, but only if its input is clear
        --silent)      nudge_mode="never"; shift;;   # explicit default: append only, Stop-hook delivers
        --force-nudge) nudge_mode="force"; shift;;   # nudge even if input has text (legacy; can clobber)
        --type)   type="${2:-note}"; shift 2;;
        --ref)    ref="${2:-}"; shift 2;;
        --from)   from="${2:-}"; shift 2;;
        *)        body_parts+=("$1"); shift;;
      esac
    done
    [ -n "$from" ] || from="$(self_target 2>/dev/null || echo unknown)"
    body="${body_parts[*]:-}"
    [ -n "$body" ] || { echo "pane-msg send: empty body" >&2; exit 1; }

    key="$(key_of "$target")"
    ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    # Safe JSON encoding via python3.
    line="$(FROM="$from" TO="$target" TYPE="$type" REF="$ref" TS="$ts" BODY="$body" \
      python3 -c 'import json,os; print(json.dumps({k.lower():os.environ[k] for k in ("FROM","TO","TYPE","REF","TS","BODY")}))')"
    printf '%s\n' "$line" >> "$MB/$key.inbox.jsonl"
    # Bump the watcher trigger file so launchd (WatchPaths) fires the delivery
    # sweeper. This is what makes delivery reliable even when the target is busy
    # right now: the sweeper retries the guarded nudge until the target is free.
    printf '%s\n' "$(date +%s)" > "$MB/.event" 2>/dev/null || true

    case "$nudge_mode" in
      never)
        echo "queued → $target (no send-time nudge; watcher / its Stop-hook will deliver)"
        ;;
      force)
        nudge "$target"
        echo "queued + nudged (forced) → $target"
        ;;
      auto)
        if input_is_clear "$target"; then
          nudge "$target"
          echo "queued + nudged → $target (input was clear)"
        else
          echo "queued → $target (busy/typing now — watcher retries until it's free)"
        fi
        ;;
    esac
    ;;

  sweep)
    # Bounded, self-terminating delivery sweeper — the launchd watcher runs this
    # on every mailbox write (WatchPaths on <MB>/.event). For each mailbox with
    # unread messages whose target pane is idle with a clear prompt, it sends a
    # guarded nudge; it loops (short window) so a target that was BUSY at send
    # time still gets woken once it frees up, then EXITS — no perpetual polling.
    # A target that stays busy long is covered by its own Stop-hook on turn end.
    window=90; interval=10
    while [ $# -gt 0 ]; do
      case "$1" in
        --window)   window="${2:-90}";  shift 2;;
        --interval) interval="${2:-10}"; shift 2;;
        *) shift;;
      esac
    done
    WLOG="${PANE_INBOX_WATCH_LOG:-/tmp/pane-inbox-watcher.log}"
    wlog() { printf '%s %s\n' "$(date -u +%H:%M:%S)" "$*" >> "$WLOG" 2>/dev/null || true; }
    shopt -s nullglob
    now="$(date +%s)"; deadline=$((now + window))
    wlog "sweep start (window=${window}s interval=${interval}s)"
    while :; do
      any_unread=0
      for inbox in "$MB"/*.inbox.jsonl; do
        key="$(basename "$inbox" .inbox.jsonl)"
        off="$MB/$key.offset"; start=0; [ -f "$off" ] && start="$(cat "$off" 2>/dev/null || echo 0)"
        total="$(wc -l < "$inbox" | tr -d ' ')"
        [ "$start" -ge "$total" ] && continue          # nothing unread here
        any_unread=1
        # Resolve the tmux target from the message's own "to" field — avoids the
        # ambiguous reverse of key_of (both ':' and '.' map to '_').
        target="$(tail -1 "$inbox" | python3 -c 'import sys,json;
try: print(json.loads(sys.stdin.readline()).get("to",""))
except Exception: print("")' 2>/dev/null)"
        [ -n "$target" ] || continue
        if input_is_clear "$target"; then
          nudge "$target"
          wlog "nudged $target ($((total-start)) unread)"
        else
          wlog "skip $target (busy/typing, $((total-start)) unread)"
        fi
      done
      [ "$any_unread" -eq 0 ] && { wlog "sweep done — all delivered/empty"; break; }
      [ "$(date +%s)" -ge "$deadline" ] && { wlog "sweep window elapsed — leaving rest to Stop-hook/stale"; break; }
      sleep "$interval"
    done
    ;;

  read|peek)
    target="${1:-$(self_target)}"
    key="$(key_of "$target")"
    inbox="$MB/$key.inbox.jsonl"
    off="$MB/$key.offset"
    [ -f "$inbox" ] || { echo "(inbox empty)"; exit 0; }
    start=0; [ -f "$off" ] && start="$(cat "$off")"
    total="$(wc -l < "$inbox" | tr -d ' ')"
    if [ "$start" -ge "$total" ]; then echo "(no new messages)"; exit 0; fi
    # Pretty-print unread lines.
    tail -n +"$((start+1))" "$inbox" | python3 -c '
import sys, json
for i, l in enumerate(sys.stdin, 1):
    l = l.strip()
    if not l:
        continue
    m = json.loads(l)
    typ = m.get("type", "note")
    frm = m.get("from", "?")
    ts = m.get("ts", "")
    ref = m.get("ref", "")
    refstr = " ref=" + ref if ref else ""
    print("── #%d [%s] from %s%s  %s" % (i, typ, frm, refstr, ts))
    print(m.get("body", ""))
    print()
'
    if [ "$cmd" = "read" ]; then printf '%s' "$total" > "$off"; fi
    ;;

  status)
    shopt -s nullglob
    stale_min="${PANE_MSG_STALE_MIN:-10}"
    any=0
    for inbox in "$MB"/*.inbox.jsonl; do
      any=1
      key="$(basename "$inbox" .inbox.jsonl)"
      off="$MB/$key.offset"; start=0; [ -f "$off" ] && start="$(cat "$off" 2>/dev/null || echo 0)"
      total="$(wc -l < "$inbox" | tr -d ' ')"
      unread=$((total-start))
      extra=""
      if [ "$unread" -gt 0 ]; then
        # Age of the OLDEST unread message (line start+1) → flag stale for humans.
        oldest_ts="$(sed -n "$((start+1))p" "$inbox" | python3 -c 'import sys,json
try: print(json.loads(sys.stdin.readline()).get("ts",""))
except Exception: print("")' 2>/dev/null)"
        agemin="$(TS="$oldest_ts" python3 -c '
import os, datetime
try:
    t = datetime.datetime.strptime(os.environ["TS"], "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=datetime.timezone.utc)
    print(int((datetime.datetime.now(datetime.timezone.utc) - t).total_seconds() // 60))
except Exception:
    print(-1)' 2>/dev/null)"
        if [ "${agemin:-0}" -ge "$stale_min" ] 2>/dev/null; then
          extra="  ⚠ STALE ${agemin}min"
        elif [ "${agemin:-0}" -ge 0 ] 2>/dev/null; then
          extra="  (oldest ${agemin}min)"
        fi
      fi
      printf '%-16s %s unread (%s total)%s\n' "$key" "$unread" "$total" "$extra"
    done
    [ "$any" -eq 1 ] || echo "(no mailboxes yet)"
    ;;

  whoami) self_target ;;

  *)
    grep '^#' "$0" | sed 's/^# \{0,1\}//' | sed '1d'
    exit 1
    ;;
esac
