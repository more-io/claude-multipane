#!/usr/bin/env bash
# pane-inbox-await — block until this pane's pane-msg inbox has unread mail,
# then exit. Wakes a Claude pane that the terminal channel cannot reach.
#
# WHY THIS EXISTS
# ---------------
# pane-msg has two delivery channels, and BOTH are blind to one specific pane:
#
#   1. The Stop hook drains the inbox at the end of a turn. A pane sitting idle
#      never ends a turn, so it never drains.
#   2. The guarded nudge types a wake line into the pane. But input_is_clear()
#      refuses outright for "the pane a human is CURRENTLY VIEWING" — and that
#      refusal is deliberate and correct: typing into someone's live prompt
#      while they read (or the TTS is speaking) is exactly what it prevents.
#
# The human-watched pane is normally the ORCHESTRATOR, which is also the pane
# that spends the most time idle waiting for replies. So its mail lands, the
# sweeper logs "skip (busy/typing)" every 10 s until its window elapses, and the
# message then waits for the human to type something. Measured 06.08.2026: every
# report from four working panes sat unread until the human poked the session by
# hand — the sweeper log shows `skip <pane> (busy/typing, 1 unread)` ten
# times in a row, then `sweep window elapsed`.
#
# Note the misleading label: nothing was busy and nobody was typing. The guard
# short-circuits on pane_active+window_active+session_attached ("111") before it
# ever looks at the input line, and reports that as "busy/typing".
#
# This tool is the third channel, and the only one that reaches that pane
# WITHOUT touching the terminal: run it as a background task from the pane
# itself. When it exits, the agent harness re-invokes the pane — which ends a
# turn, which runs the Stop hook, which drains the inbox. The terminal is never
# written to, so the reason the nudge was refused does not apply.
#
# It deliberately does NOT consume the messages: draining stays the Stop hook's
# job, so there is exactly one reader and no way for the two to disagree about
# what has been seen.
#
# ONE WATCHER PER TARGET, AND ONLY REAL TARGETS
# ---------------------------------------------
# Measured 10.10.2026: one orchestrator pane had EIGHT of these running, all on
# the target "fourlater:pane1" — a Claude session name, not a tmux pane — so all
# eight watched a mailbox no sender ever writes to and each reported "no mail"
# an hour later. Two guards close that:
#
#   * A pid file per target (<state>/pane-inbox-await.<key>.pid). A second start
#     for the same target exits 0 with "already armed (pid N)". A watcher started
#     by an older version of this script has no pid file; those are recognised
#     by their command line instead, so the lock is honest during the upgrade.
#   * The target must be a LIVE tmux pane, spelled exactly as tmux prints it
#     (session:window.pane). tmux resolves a bogus or partial target to the
#     caller's own pane and exits 0 — "4later:1.9", "4later" and even
#     "4later:1.1x" all come back as 4later:1.1 — so the exit code proves
#     nothing. The resolved pane id must be non-empty AND the canonical form
#     must equal the argument verbatim, because the mailbox key is derived from
#     the literal string. A rejection lists the live panes and, when the
#     argument is a Claude session name with a registry entry (`tmux` field in
#     ~/.claude/sessions/*.json) or a "paneN" shorthand from panes.conf, the
#     target it maps to.
#
# Usage:
#   pane-inbox-await                        # auto-detect self, waits up to 7 days
#   pane-inbox-await --timeout 1800         # shorter window
#   pane-inbox-await mysession:1.1          # explicit target
#
# Exit code is 0 on mail found, window elapsed AND already armed. A non-zero
# exit would read as a failed task and invite someone to "fix" a timeout that is
# the normal quiet case. Only an invalid target exits 2 — there the right
# reaction IS to fix the call.
set -euo pipefail

MB="${PANE_MSG_HOME:-$HOME/.claude/tmux-state/mailbox}"
STATE="${PANE_INBOX_AWAIT_STATE:-$HOME/.claude/tmux-state}"
SESSIONS="${PANE_INBOX_AWAIT_SESSIONS:-$HOME/.claude/sessions}"
PANES_CONF="${PANE_INBOX_AWAIT_PANES_CONF:-$HOME/.claude/panes.conf}"
# 7 days, not 1 h (14.10.2026): every quiet hour used to end the task, wake the
# pane with "no mail" and need a manual re-arm. The watcher now exits on mail.
timeout=604800
interval=30
target=""

while [ $# -gt 0 ]; do
  case "$1" in
    --timeout) timeout="$2"; shift 2 ;;
    --interval) interval="$2"; shift 2 ;;
    -h|--help) sed -n '1,65p' "$0"; exit 0 ;;
    *) target="$1"; shift ;;
  esac
done

# Identify this pane STRICTLY from $TMUX_PANE, the unique id of the pane this
# process runs in — never from the client's ACTIVE pane, which would watch the
# wrong mailbox the moment the human switches panes.
if [ -z "$target" ]; then
  [ -n "${TMUX_PANE:-}" ] || { echo "pane-inbox-await: not inside tmux and no target given"; exit 0; }
  target="$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}:#{window_index}.#{pane_index}' 2>/dev/null || true)"
  [ -n "$target" ] || { echo "pane-inbox-await: could not resolve own pane"; exit 0; }
fi

# Live panes as targets, one per line.
live_targets() {
  tmux list-panes -a -F '#{session_name}:#{window_index}.#{pane_index}' 2>/dev/null
}

# Map a Claude session name (registry `name`, e.g. "fourlater:pane1") to the
# tmux target of the pane that session runs in. The registry stores the pane as
# "session:@window.%pane" (ids); the pane id is what tmux resolves exactly.
# Only live, interactive entries count — a stale or background registration
# must not point anyone at a dead pane.
suggest_from_registry() {
  local name="$1"
  [ -d "$SESSIONS" ] || return 0
  NAME="$name" SESSIONS="$SESSIONS" python3 -c '
import glob, json, os, subprocess
name = os.environ["NAME"]
for f in glob.glob(os.path.join(os.environ["SESSIONS"], "*.json")):
    try:
        d = json.load(open(f))
    except Exception:
        continue
    if d.get("name") != name or d.get("kind") != "interactive":
        continue
    pid = d.get("pid")
    try:
        os.kill(int(pid), 0)
    except Exception:
        continue
    pane = str(d.get("tmux", "")).rsplit(".", 1)[-1]
    if not pane.startswith("%"):
        continue
    r = subprocess.run(["tmux", "display-message", "-p", "-t", pane,
                        "#{session_name}:#{window_index}.#{pane_index}"],
                       capture_output=True, text=True)
    t = r.stdout.strip()
    if r.returncode == 0 and t:
        print(t)
' 2>/dev/null || true
}

# Map a "paneN" shorthand (bare or "<anything>:paneN") to <prefix>.N for every
# project in panes.conf — cheap, and exactly the shorthand that produced dead
# mailboxes before.
suggest_from_panes_conf() {
  local name="$1" n prefix
  [ -f "$PANES_CONF" ] || return 0
  n="$(printf '%s' "$name" | sed -nE 's/^([^:]+:)?pane([0-9]+)$/\2/p')"
  [ -n "$n" ] || return 0
  while read -r _proj _path _branch _count prefix _rest; do
    case "$_proj" in ''|'#'*) continue ;; esac
    [ -n "$prefix" ] && printf '%s.%s\n' "$prefix" "$n"
  done < "$PANES_CONF"
}

# Validate: resolved pane id non-empty AND canonical form == argument.
resolved="$(tmux display-message -p -t "$target" '#{pane_id}|#{session_name}:#{window_index}.#{pane_index}' 2>/dev/null || true)"
pane_id="${resolved%%|*}"
canonical="${resolved#*|}"
if [ -z "$pane_id" ] || [ "$canonical" != "$target" ]; then
  {
    echo "pane-inbox-await: '$target' is not a live tmux pane target — refusing to watch a mailbox nobody drains."
    echo "  Targets are spelled session:window.pane exactly as tmux prints them."
    suggestions="$( { suggest_from_registry "$target"; suggest_from_panes_conf "$target"; } | awk 'NF && !seen[$0]++')"
    if [ -n "$suggestions" ]; then
      live="$(live_targets)"
      printf '%s\n' "$suggestions" | while read -r s; do
        if printf '%s\n' "$live" | grep -qxF "$s"; then
          echo "  Did you mean: $s   (that is where '$target' runs)"
        fi
      done
    fi
    echo "  Live panes:"
    live_targets | sed 's/^/    /'
  } >&2
  exit 2
fi

# Mailbox key: the target with separators flattened, matching pane-msg.
key="$(printf '%s' "$target" | tr ':.' '__')"
inbox="$MB/$key.inbox.jsonl"
offset="$MB/$key.offset"
mkdir -p "$STATE"
pidfile="$STATE/pane-inbox-await.$key.pid"

# Is <pid> a living pane-inbox-await process? kill -0 alone would also accept a
# recycled pid that now belongs to something else.
is_await_pid() {
  local pid="$1"
  [ -n "$pid" ] && [ "$pid" != "$$" ] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  ps -o command= -p "$pid" 2>/dev/null | grep -q 'pane-inbox-await'
}

# Watchers started by the pre-lock version carry no pid file. Recognise them by
# command line: "<interpreter> <path>pane-inbox-await [flags] <target>" — the
# anchor at the start keeps shell wrappers ("/bin/zsh -c ... pane-inbox-await
# 4later:1.1 | tail") from matching, which would otherwise look like a live
# watcher and talk a real one out of starting.
legacy_watcher_pid() {
  local re
  re="$(printf '%s' "$target" | sed 's/[.[\*^$]/\\&/g')"
  pgrep -f "^([^ ]+ )?[^ ]*pane-inbox-await( --[a-z]+ [^ ]+)* ${re}\$" 2>/dev/null \
    | grep -v -x -e "$$" -e "$PPID" | head -1 || true
}

# Atomic create via noclobber; on failure, judge the owner. A stale pid file
# (owner gone) is taken over, a living owner wins.
acquire_lock() {
  local tries=0 owner
  while :; do
    if ( set -o noclobber; printf '%s\n' "$$" > "$pidfile" ) 2>/dev/null; then
      return 0
    fi
    owner="$(cat "$pidfile" 2>/dev/null | tr -d '[:space:]' || true)"
    if is_await_pid "$owner"; then
      echo "pane-inbox-await: already armed for $target (pid $owner) — nothing to do."
      exit 0
    fi
    rm -f "$pidfile"
    tries=$((tries + 1))
    if [ "$tries" -ge 3 ]; then
      echo "pane-inbox-await: could not take the lock for $target ($pidfile) — giving up."
      exit 0
    fi
  done
}

# Order matters: a watcher that owns the pid file is judged first (it is also
# visible by command line, and must not be reported as a pre-lock one).
owner="$(cat "$pidfile" 2>/dev/null | tr -d '[:space:]' || true)"
if is_await_pid "$owner"; then
  echo "pane-inbox-await: already armed for $target (pid $owner) — nothing to do."
  exit 0
fi
legacy="$(legacy_watcher_pid)"
if [ -n "$legacy" ]; then
  echo "pane-inbox-await: already armed for $target (pid $legacy, started by the pre-lock version) — nothing to do."
  exit 0
fi

acquire_lock
# Release only a lock that is ours; a TERM/INT must run the EXIT trap too, or
# `pkill` would leave a stale pid file behind.
cleanup() { [ "$(cat "$pidfile" 2>/dev/null | tr -d '[:space:]')" = "$$" ] && rm -f "$pidfile"; return 0; }
trap cleanup EXIT
trap 'exit 143' TERM INT HUP

# Unread is computed EXACTLY as pane-msg's sweeper computes it (line count minus
# the read offset). Two different arithmetics over the same files would drift,
# and the drift would look like a delivery bug.
unread_count() {
  local total=0 start=0
  [ -f "$inbox" ] && total="$(wc -l < "$inbox" | tr -d ' ')"
  [ -f "$offset" ] && start="$(cat "$offset" 2>/dev/null || echo 0)"
  echo $(( total - start ))
}

deadline=$(( $(date +%s) + timeout ))

# Check BEFORE the first sleep: mail that arrived while the previous turn was
# still running is the common case, and sleeping on it would add a whole
# interval of silence for no reason.
while :; do
  n="$(unread_count)"
  if [ "$n" -gt 0 ]; then
    echo "📨 $n unread message(s) waiting for $target — run 'pane-msg read' (the Stop hook will also drain them)."
    exit 0
  fi
  if [ "$(date +%s)" -ge "$deadline" ]; then
    # One quiet line. The re-arm reminder lives in the Stop hook, which only
    # speaks when mail actually arrived; repeating it here turned every quiet
    # hour into a turn with nothing to say.
    echo "pane-inbox-await: no mail for $target within ${timeout}s."
    exit 0
  fi
  sleep "$interval"
done
